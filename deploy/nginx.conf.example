# Exemplo de vhost Nginx para cliente.provedorsupersonic.com.br
#
# Serve o build estático do Vite (npm run build -> dist/) e faz o reverse
# proxy de /api/* para o backend real (controllr.provedorsupersonic.com.br), reescrevendo o
# domínio do cookie de sessão — sem isso, o navegador nunca aceita o
# BRBOSCookie pra um domínio diferente do que respondeu o Set-Cookie
# (ver README.md, seção "Reverse proxy em produção").
#
# Ajuste os caminhos de certificado (ssl_certificate/ssl_certificate_key)
# e o "root" pro local real onde o conteúdo de dist/ for publicado.

server {
    listen 80;
    listen [::]:80;
    server_name cliente.provedorsupersonic.com.br;

    # Redireciona tudo pra HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cliente.provedorsupersonic.com.br;

    ssl_certificate     /etc/letsencrypt/live/cliente.provedorsupersonic.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cliente.provedorsupersonic.com.br/privkey.pem;

    root /var/www/supersonic-web/dist;
    index index.html;

    # SPA: qualquer rota que não bata em um arquivo real cai no index.html
    # (o roteamento de fato acontece no react-router-dom, no navegador).
    #
    # Cabeçalhos de segurança só aqui em "location /" (não em "server{}"
    # nem nas locations de proxy abaixo) DE PROPÓSITO: um "add_header" em
    # "server{}" seria herdado só enquanto a location não tiver o seu
    # próprio (regra de herança do Nginx) — mas as páginas do Controllr
    # proxiadas (/api, /public, /common, /assets) são HTML de um sistema
    # legado que não controlamos, provavelmente com <style>/<script>
    # inline; aplicar a mesma CSP restritiva nelas quebraria essas
    # páginas. Aqui é só pro HTML/JS/CSS do NOSSO build.
    location / {
        try_files $uri /index.html;

        # 'unsafe-inline' NÃO é necessário em style-src: o React seta
        # estilo inline via propriedade do DOM (CSSOM), não via atributo
        # "style=" no HTML nem <style> — isso não é bloqueado por CSP.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # geolocation=(self): usado no compartilhamento de localização do
        # Suporte (ver DetalheChamado.tsx). O resto vai desligado — nada
        # aqui usa câmera/microfone/pagamento via API do navegador (o
        # anexo de foto usa <input type="file" capture>, que abre o app
        # de câmera do sistema sem precisar de permissão via API).
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # NUNCA cachear o que passa por aqui (index.html, sw.js,
        # workbox-*.js, manifest.webmanifest) — é assim que o navegador
        # descobre que existe uma versão nova pra instalar: ele só nota
        # a diferença se buscar esses arquivos de novo na rede. Sem
        # "Cache-Control" nenhum, a política padrão do navegador podia
        # manter o sw.js "antigo" guardado por horas/dias, escondendo
        # atualizações até o cliente limpar os dados manualmente (bug
        # relatado e confirmado — era exatamente isso). Os arquivos
        # dentro de /assets/ têm hash no nome (mudam de URL sempre que o
        # conteúdo muda), então esses sim podem — e devem — cachear por
        # muito tempo (ver location /assets/ abaixo).
        add_header Cache-Control "no-cache" always;
    }

    # Reverse proxy do backend Controllr/BRbyte — mesma lógica do proxy de
    # desenvolvimento do Vite (vite.config.ts), só que aqui é o Nginx quem
    # faz esse papel em produção.
    location /api/ {
        proxy_pass https://controllr.provedorsupersonic.com.br/;

        # O padrão do Nginx (1m) é menor que uma foto de câmera comum —
        # sem isso, o anexo de chamado (support_ctl/annex/upload, foto/
        # galeria/documento) é rejeitado com 413 ANTES de chegar no
        # Controllr, e o Nginx devolve uma página de erro em HTML (não
        # JSON) que quebra o response.json() do cliente (client.ts) com
        # "Unexpected token... is not valid JSON". Mensagens de texto e
        # localização (support_ctl/op/create) não têm esse problema por
        # serem POSTs pequenos — só o upload de arquivo é afetado.
        client_max_body_size 20m;

        proxy_set_header Host controllr.provedorsupersonic.com.br;
        # IP de origem do cliente pro backend — sem isso, todo acesso via
        # este portal aparece pro Controllr com o IP DESTE SERVIDOR (o
        # proxy), não o do cliente de verdade, atrapalhando
        # localização/geolocalização e qualquer log baseado em IP.
        # IMPORTANTE: só mandar o cabeçalho aqui não basta — o Controllr
        # também precisa estar configurado do lado dele pra CONFIAR e LER
        # esse cabeçalho vindo do IP deste servidor (não é algo deste
        # repositório).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # OBRIGATÓRIO: reescreve o domínio do Set-Cookie de controllr.provedorsupersonic.com.br
        # pra cliente.provedorsupersonic.com.br, senão o navegador descarta o cookie
        # de sessão (BRBOSCookie) por não bater com o domínio da página.
        proxy_cookie_domain controllr.provedorsupersonic.com.br cliente.provedorsupersonic.com.br;

        # Preserva o path do lado de baixo (o "/api" some da URL real).
        proxy_ssl_server_name on;
    }

    # Páginas geradas pelo próprio backend (ex: o layout de impressão do
    # boleto, invoice_ctl/invoice/print_layout, servido via /api acima)
    # referenciam logo/ícones com caminho absoluto (ex:
    # "/public/assets/uploaddir/logo/office/1/logo.png"), esperando estar
    # em controllr.provedorsupersonic.com.br — sem repassar essas duas rotas também, essas
    # imagens quebram (o navegador tenta buscar no nosso próprio domínio).
    # Sem barra no fim do proxy_pass: preserva o path igual dos dois lados.
    location /public/ {
        proxy_pass https://controllr.provedorsupersonic.com.br;
        proxy_ssl_server_name on;
    }

    location /common/ {
        proxy_pass https://controllr.provedorsupersonic.com.br;
        proxy_ssl_server_name on;
    }

    # A tela de impressão do CONTRATO referencia o logo direto em
    # "/assets/..." (sem o prefixo "/public" que o boleto usa) — só que
    # "/assets/" também é onde o PRÓPRIO build do Vite guarda seus
    # arquivos (JS/CSS com hash). Serve o arquivo local se ele existir;
    # só cai pro backend (named location abaixo) quando não existir.
    location /assets/ {
        try_files $uri @assets_backend;

        # Só quando o arquivo é servido DAQUI (do nosso build) — cai pro
        # @assets_backend (proxy pro Controllr) antes de gerar resposta
        # quando o arquivo local não existe, então esse header nunca vai
        # junto nesse outro caso. Cache por 1 ano vale porque o nome do
        # arquivo muda sempre que o conteúdo muda (hash no nome, ex:
        # index-D4VyL3qq.js) — nunca serve um arquivo "errado" do cache
        # com esse esquema, "immutable" é seguro de verdade aqui.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location @assets_backend {
        proxy_pass https://controllr.provedorsupersonic.com.br;
        proxy_ssl_server_name on;
    }
}
